{
  "expo": {
    "name": "KMRG",
    "slug": "kmrg-mobile",
    "scheme": "kmrg",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kmrg.app"
    },
    "android": {
      "package": "com.kmrg.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5ff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#9333ea"
        }
      ],
      "expo-status-bar",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KmrgCoupleWidget",
              "label": "KMRG Amor (Completo)",
              "minWidth": "320dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Nuestros días juntos, la notita del día y aviso de latidos de amor.",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KmrgMiniWidget",
              "label": "KMRG Amor (Compacto)",
              "minWidth": "160dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Contador de días juntos y aviso de latidos.",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf5ff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class androidx.room.** { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class * extends androidx.work.Worker { <init>(...); }\n-keep class * extends androidx.work.ListenableWorker { <init>(...); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f11a031-8db2-49bd-be59-44f2a3426c2a"
      }
    },
    "owner": "kmrg"
  }
}

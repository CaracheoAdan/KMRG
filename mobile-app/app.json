{
  "expo": {
    "name": "KMRG",
    "slug": "kmrg-mobile",
    "scheme": "kmrg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff0f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kmrg.app"
    },
    "android": {
      "package": "com.kmrg.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff0f3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e63946"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "7f11a031-8db2-49bd-be59-44f2a3426c2a"
      }
    },
    "owner": "kmrg"
  }
}

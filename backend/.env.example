# Puerto de la API
PORT=4000
NODE_ENV=development

# Nivel de log estructurado (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kmrg_db?schema=public

# Secreto para firma y verificación de JWT (Admin) - mínimo 32 caracteres
JWT_SECRET=super_secret_jwt_key_kmrg_change_in_production_32chars

# Clave API estática para peticiones permitidas desde la App Móvil - mínimo 24 caracteres
MOBILE_API_KEY=kmrg_mobile_secure_api_key_2026

# Origen permitido del Panel de Administración Web para CORS
ADMIN_WEB_URL=http://localhost:5173

# Duración del JWT de admin y de la cookie httpOnly kmrg_session (ej: 12h, 1d, 30m)
JWT_EXPIRES_IN=12h

# Permitir que un admin autenticado registre otros admins vía POST /api/auth/register
ALLOW_ADMIN_REGISTRATION=false

# Número de proxies inversos de confianza (0 en local, 1 detrás de Nginx/Render/Railway)
TRUST_PROXY=0

# Credenciales para el seed inicial (npm run prisma:seed)
# SEED_ADMIN_PASSWORD es obligatorio al ejecutar el seed (mínimo 8 caracteres)
SEED_ADMIN_EMAIL=admin@kmrg.app
SEED_ADMIN_PASSWORD=12345678

# Conexión opcional con Supabase Cloud (para sincronización bidireccional en vivo con la App Móvil)
SUPABASE_URL=https://pnkhsdoprjssiimwlijc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_FXyQRy0c_S4TyiayCQtAcQ_uJMVLWSZ

# PRODUCCIÓN: genera secretos aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# El servidor se niega a arrancar con NODE_ENV=production si detecta los valores de ejemplo.
